# Copy to api.env and provide per-environment credentials before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-use
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
DATABASE_URL=postgres://postgres:replace-before-use@db:5432/outiscloud
FORCE_BOOTSTRAP=false
JWT_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_NAMESERVERS=ns1.example.invalid,ns2.example.invalid
