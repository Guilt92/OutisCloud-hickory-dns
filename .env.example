# Hickory DNS Production Environment Template
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Generate these with secure random values
# =============================================================================

# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Database password (must match POSTGRES_PASSWORD in db.env)
DATABASE_PASSWORD=your-strong-database-password

# Admin password for the control panel
ADMIN_PASSWORD=your-strong-admin-password

# =============================================================================
# REQUIRED - Update these values for your deployment
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=your-strong-database-password
# Control API PostgreSQL session pools (default: 8 query + min(8, 4) transaction sessions)
# DB_POOL_SIZE=8
# DB_TRANSACTION_POOL_SIZE=4

# API Base URL (use internal network URL in production)
# For production behind a reverse proxy, use: https://your-domain.com
API_BASE_URL=http://localhost:8080

# =============================================================================
# OPTIONAL - Customize these for your deployment
# =============================================================================

# Port configurations
UI_PORT=8081
DOT_PORT=853

# Host interface to publish the DNS service on (default 0.0.0.0 = all interfaces).
# Set this to your server's public or LAN IP only if port 53 is already held
# open on the server (e.g. by the systemd-resolved stub on Debian/Ubuntu),
# which would otherwise make the wildcard bind fail with 'address already in use'.
# Example: DNS_BIND_IP=203.0.113.10
DNS_BIND_IP=0.0.0.0

# Admin username (optional - default is 'admin')
ADMIN_USERNAME=admin

# Allowed CORS origins (comma-separated)
# the default list includes the UI development address so that developers
# running the project with docker-compose can log in immediately.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# --- phase 6/7 additions (see docs/OPERATIONS.md) ---
# Ordered DNS Lookup resolvers (label=addr, IPv4/IPv6). No public default exists.
# DNS_LOOKUP_RESOLVERS=internal=10.0.0.53,backup=[2001:db8::53]:53
# DNS_LOOKUP_TIMEOUT_MS=2000
# DNS_LOOKUP_DEADLINE_MS=6000
# DNS_LOOKUP_RATE_PER_MIN=30
# Analytics (control API) and DNS-server counters
# ANALYTICS_SAMPLE_SECS=60
# ANALYTICS_LEASE_SECS=180
# ANALYTICS_RETENTION_DAYS=90
# DNS_ZONE_QUERY_METRICS=true   # DNS server
# DNS_ZONE_BREAKDOWN=true       # DNS server: record type + country (needs GEOIP_DB_PATH)
# GEOIP_DB_PATH=/etc/hickory/GeoLite2-Country.mmdb
# DEFAULT_TENANT_MAX_ZONES=
# DEFAULT_TENANT_MAX_RECORDS=
